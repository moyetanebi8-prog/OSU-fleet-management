# Copy this file to backend/.env and fill in real values for your machine.
# Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://fms_user:fms_password@localhost:5432/fms_db

# Separate database used only by the pytest suite (see db-init/, tests/conftest.py)
TEST_DATABASE_URL=postgresql+psycopg://fms_user:fms_password@localhost:5432/fms_test_db

# JWT
SECRET_KEY=replace-with-a-long-random-secret-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared key GPS-sending devices (and the simulator) authenticate with -
# sent as the X-Device-API-Key header on POST /api/v1/pings/. Not a user
# account/JWT - vehicles aren't requesters or dispatchers.
DEVICE_API_KEY=replace-with-a-long-random-device-key

# Business rules
DEFAULT_SPEED_LIMIT_KMH=80
GEOFENCE_CHECK_ENABLED=true

# Email (SMTP) - required for driver/traveler/requester notifications and
# employee-onboarding emails to actually send. Leave SMTP_HOST empty in
# local dev if you don't have a mail server - sends will fail loudly and
# be recorded as "failed" in the notifications table rather than silently
# pretending to succeed. Any real SMTP provider works (Gmail app password,
# SendGrid, Mailtrap for testing, your company's mail server, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Fleet Management System
